{
  "name": "kyoto-hacker-way-20260521",
  "version": "0.0.0",
  "private": true,
  "description": "Slides and sample apps for Kyoto Hacker Way 2026-05-21",
  "scripts": {
    "dev": "npm run build:diagrams && marp --server .",
    "build:diagrams": "node scripts/build-diagrams.mjs",
    "build:html": "npm run build:diagrams && marp events/20260521_kyoto-hacker-way/20260521_kyoto-hacker-way.md -o dist/20260521_kyoto-hacker-way/index.html && node -e \"require('node:fs').cpSync('events/20260521_kyoto-hacker-way/assets','dist/20260521_kyoto-hacker-way/assets',{recursive:true})\"",
    "build:pdf": "npm run build:diagrams && marp --pdf --allow-local-files events/20260521_kyoto-hacker-way/20260521_kyoto-hacker-way.md -o dist/20260521_kyoto-hacker-way.pdf",
    "build:pptx": "npm run build:diagrams && marp --pptx --allow-local-files events/20260521_kyoto-hacker-way/20260521_kyoto-hacker-way.md -o dist/20260521_kyoto-hacker-way.pptx",
    "build": "npm run build:site",
    "build:site": "npm run build:diagrams && node scripts/build-site.mjs",
    "fetch:logos": "node scripts/fetch-logos.mjs events/20260521_kyoto-hacker-way",
    "preview": "npm run build:site && wrangler dev",
    "deploy": "npm run build:site && wrangler deploy"
  },
  "devDependencies": {
    "@marp-team/marp-cli": "^4.5.1",
    "@marp-team/marp-core": "^4.4.0",
    "@mermaid-js/mermaid-cli": "^12.2.0",
    "wrangler": "^4.164.0"
  },
  "overrides": {
    "@marp-team/marp-cli": {
      "puppeteer-core": "^25.18.1"
    },
    "@marp-team/marp-core": {
      "katex": "^0.18.10"
    }
  }
}
